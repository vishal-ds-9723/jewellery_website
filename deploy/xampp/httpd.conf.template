# Dedicated XAMPP Apache instance, generated by tools/start-xampp.ps1.
ServerRoot "@APACHE_ROOT@"
Listen 127.0.0.1:@PORT@
ServerName 127.0.0.1:@PORT@
PidFile "@SITE_ROOT@/storage/framework/xampp-httpd.pid"
LoadModule authz_core_module modules/mod_authz_core.so
LoadModule authz_host_module modules/mod_authz_host.so
LoadModule dir_module modules/mod_dir.so
LoadModule mime_module modules/mod_mime.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule rewrite_module modules/mod_rewrite.so
LoadModule headers_module modules/mod_headers.so
LoadModule expires_module modules/mod_expires.so
LoadModule filter_module modules/mod_filter.so
LoadModule deflate_module modules/mod_deflate.so
LoadModule env_module modules/mod_env.so
LoadModule setenvif_module modules/mod_setenvif.so
LoadFile "@PHP_ROOT@/php8ts.dll"
LoadFile "@PHP_ROOT@/libsqlite3.dll"
LoadModule php_module "@PHP_ROOT@/php8apache2_4.dll"
PHPIniDir "@SITE_ROOT@/storage/framework/xampp"
TypesConfig conf/mime.types
AddType image/webp .webp
DirectoryIndex index.php
DocumentRoot "@SITE_ROOT@/public"
<Directory />
    AllowOverride None
    Require all denied
</Directory>
<Directory "@SITE_ROOT@/public">
    Options -Indexes +FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>
ThreadsPerChild 64
MaxConnectionsPerChild 10000
KeepAlive On
MaxKeepAliveRequests 100
KeepAliveTimeout 2
Timeout 30
LimitRequestBody 1048576
ServerTokens Prod
ServerSignature Off
ErrorLog "@SITE_ROOT@/storage/logs/xampp-apache-error.log"
LogLevel warn
LogFormat "%h %t \"%r\" %>s %b %D" timed
CustomLog "@SITE_ROOT@/storage/logs/xampp-apache-access.log" timed
