[PHP]
extension_dir="@PHP_ROOT@/ext"
extension=curl
extension=fileinfo
extension=mbstring
extension=exif
extension=gd
extension=openssl
extension=pdo_mysql
extension=pdo_sqlite
extension=sqlite3
extension=intl
extension=zip
date.timezone=UTC
memory_limit=256M
max_execution_time=30
max_input_time=30
post_max_size=1M
upload_max_filesize=1M
max_input_vars=100
expose_php=Off
display_errors=Off
log_errors=On
error_log="@SITE_ROOT@/storage/logs/xampp-php-error.log"
sys_temp_dir="@SITE_ROOT@/storage/framework/xampp"
session.save_path="@SITE_ROOT@/storage/framework/sessions"
realpath_cache_size=4096K
realpath_cache_ttl=120

[opcache]
; PHP 8.5 includes OPcache. Retain timestamp checks during development.
opcache.enable=1
opcache.enable_cli=0
opcache.memory_consumption=256
opcache.interned_strings_buffer=16
opcache.max_accelerated_files=20000
opcache.validate_timestamps=1
opcache.revalidate_freq=2
opcache.jit=disable
